# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://narcymorph:password@localhost:5432/narcymorph?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-key-minimum-32-characters
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-to-another-random-secret-key
JWT_REFRESH_EXPIRATION=7d

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MODEL_CHEAP=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Azure Face API (Optional)
AZURE_FACE_API_KEY=your-azure-face-api-key
AZURE_FACE_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_FACE_API_VERSION=v1.0

# AWS Rekognition (Alternative to Azure)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Storage - Cloudinary (Recommended)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Storage - AWS S3 (Alternative)
AWS_S3_BUCKET=narcymorph-uploads
AWS_S3_REGION=us-east-1

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Upload Limits
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs

# Email (Future - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@narcymorph.com

# Webhook (Future)
WEBHOOK_SECRET=your-webhook-secret

# Feature Flags
ENABLE_FACE_ANALYSIS=true
ENABLE_CHAT=true
ENABLE_SOCIAL=true
ENABLE_PREMIUM=false

# Analytics (Optional)
SENTRY_DSN=
POSTHOG_API_KEY=
